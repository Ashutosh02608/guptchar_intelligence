# ==============================================================================
# Guptchar - 24*7 Regulatory Surveillance & Intelligence Engine
# Environment Configuration (.env)
# ==============================================================================

# --- DATABASE CONFIGURATION (Neon Serverless PostgreSQL) ---
# Neon PostgreSQL Connection URL (Requires SSL)
# Format: postgresql://[user]:[password]@[endpoint-pooler].us-east-2.aws.neon.tech/[dbname]?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:your_password@ep-round-tooth-b54dxxnk-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-round-tooth-b54dxxnk-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- SERVER CONFIGURATION ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# --- AI & SECTOR IMPACT REASONER CONFIGURATION ---
# Provider selection: "auto" (default), "gemini", "openai", "anthropic", "ollama", "heuristic"
AI_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama Local LLM (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AI Performance & Timeouts
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# --- SMTP MAIL DISPATCH CONFIGURATION ---
# Compatible with Gmail SMTP, Brevo, SendGrid, Amazon SES, or any standard SMTP server.
# For Gmail: Use smtp.gmail.com with an App Password (generated in Google Account -> Security -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Guptchar Intelligence
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- AUTHENTICATION & ACCESS CONTROL (Neon Database Users Table) ---
# Operator accounts are stored securely in the Neon PostgreSQL "users" table.
# To create an initial administrator account, run:
#   python backend/create_user.py --username <username> --email <email> --password <password>
# Or provide credentials below for one-time initialization on boot:
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
AUTH_SECRET_KEY=your_secure_random_signing_key_here
